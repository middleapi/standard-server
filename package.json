{
  "name": "@standard-server/repo",
  "type": "module",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "uncheck prepare --pre-commit",
    "check": "uncheck",
    "fix": "uncheck --fix",
    "test": "pnpm run -r test && vitest run",
    "test:coverage": "pnpm run -r test && vitest run --coverage",
    "bench": "vitest bench --run",
    "sponsors:sync": "node scripts/sync-sponsors.ts && pnpm run fix '**/README.md'"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@hono/node-server": "^2.0.12",
    "@remix-run/node-fetch-server": "^0.14.0",
    "@standard-server/core": "workspace:*",
    "@standard-server/fastify": "workspace:*",
    "@standard-server/fetch": "workspace:*",
    "@standard-server/node": "workspace:*",
    "@standard-server/peer": "workspace:*",
    "@standard-server/shared": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/express4": "npm:@types/express@^4.17.25",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^12.1.1",
    "changelogithub": "^15.0.4",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "fastify": "^5.11.0",
    "h3": "2.0.1-rc.26",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pkg-pr-new": "^0.0.87",
    "selfsigned": "^5.5.0",
    "sherif": "^1.13.0",
    "srvx": "^0.12.5",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "uncheck": "^0.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
