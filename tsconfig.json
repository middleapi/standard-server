{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "uncheck/tsconfig/middleapi",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "playground",
    "scripts",
    "benches",
    "tests",
    "*",

    "*/*/src/**/*.bench.*",
    "*/*/src/**/*.test.*",
    "*/*/src/**/*.test-d.ts",
    "*/*/src/**/__tests__",
    "*/*/src/**/__mocks__",
    "*/*/src/**/__snapshots__",
    "*/*/playground",
    "*/*/scripts",
    "*/*/benches",
    "*/*/tests",
    "*/*/*"
  ],
  "exclude": ["playgrounds/**", "tests/bun/**", "tests/deno/**"]
}
