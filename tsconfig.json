{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",

    "types": ["node", "vitest/globals"],

    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "*",
    "scripts",
    "benches",
    "tests",
    "*/*/*",
    "*/*/tests",
    "*/*/benches",
    "*/*/src/**/*.test.ts",
    "*/*/src/**/*.test-d.ts"
  ],
  "exclude": ["playgrounds/**", "tests/bun/**"]
}
