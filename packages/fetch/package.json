{
  "name": "@standard-server/fetch",
  "version": "0.15.0",
  "description": "Fetch API adapter for Standard Server: transport-agnostic requests, responses, and streaming for browsers, workers, Deno, Bun, and any Fetch-based runtime",
  "keywords": [
    "adapter",
    "browser",
    "bun",
    "deno",
    "fetch",
    "http",
    "request",
    "response",
    "server",
    "service-worker",
    "sse",
    "standard-server",
    "streaming",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/standard-server.git",
    "directory": "packages/fetch"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc"
  },
  "dependencies": {
    "@standard-server/core": "workspace:*",
    "@standard-server/shared": "workspace:*"
  }
}
