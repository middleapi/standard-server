{
  "name": "@standard-server/shared",
  "version": "0.14.0",
  "description": "Internal types and utilities shared across the Standard Server ecosystem",
  "keywords": [
    "internal",
    "standard-server",
    "typescript",
    "utilities",
    "utils"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/standard-server.git",
    "directory": "packages/shared"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc"
  }
}
